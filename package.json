{
  "name": "perplexicode-kilo",
  "displayName": "PerplexiCode Kilo",
  "description": "Kilo Code-style autonomous coding agent (Code / Architect / Ask / Debug / Orchestrator / Review modes, tools, diffs, checkpoints, auto-approve) powered by your Perplexity Pro/Max subscription and its latest models.",
  "version": "2.1.0",
  "publisher": "MRX7999",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "perplexity",
    "ai",
    "coding-agent",
    "kilo",
    "agent",
    "claude",
    "gpt",
    "gemini",
    "grok",
    "autonomous"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MRX7999/PerplexiCode-Kilo.git"
  },
  "homepage": "https://github.com/MRX7999/PerplexiCode-Kilo#readme",
  "bugs": {
    "url": "https://github.com/MRX7999/PerplexiCode-Kilo/issues"
  },
  "qna": "https://github.com/MRX7999/PerplexiCode-Kilo/discussions",
  "pricing": "Free",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "perplexicodeKilo-sidebar",
          "title": "PerplexiCode Kilo",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "perplexicodeKilo-sidebar": [
        {
          "type": "webview",
          "id": "perplexicodeKilo.chatView",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "perplexicodeKilo.newTask",
        "title": "New Task",
        "category": "PerplexiCode",
        "icon": "$(add)"
      },
      {
        "command": "perplexicodeKilo.history",
        "title": "Task History",
        "category": "PerplexiCode",
        "icon": "$(history)"
      },
      {
        "command": "perplexicodeKilo.settings",
        "title": "Settings",
        "category": "PerplexiCode",
        "icon": "$(gear)"
      },
      {
        "command": "perplexicodeKilo.openInTab",
        "title": "Open in Editor Tab",
        "category": "PerplexiCode",
        "icon": "$(link-external)"
      },
      {
        "command": "perplexicodeKilo.openChat",
        "title": "Open Agent",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.addAccount",
        "title": "Add Perplexity Account",
        "category": "PerplexiCode",
        "icon": "$(person-add)"
      },
      {
        "command": "perplexicodeKilo.manageAccounts",
        "title": "Manage Accounts",
        "category": "PerplexiCode",
        "icon": "$(account)"
      },
      {
        "command": "perplexicodeKilo.selectModel",
        "title": "Select Model / Mode",
        "category": "PerplexiCode",
        "icon": "$(sparkle)"
      },
      {
        "command": "perplexicodeKilo.cycleMode",
        "title": "Switch to Next Mode",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.setRotationStrategy",
        "title": "Set Account Rotation Strategy",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.refreshModels",
        "title": "Refresh Models and Quotas",
        "category": "PerplexiCode",
        "icon": "$(refresh)"
      },
      {
        "command": "perplexicodeKilo.explainCode",
        "title": "Explain Code",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.fixCode",
        "title": "Fix Code",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.improveCode",
        "title": "Improve Code",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.addToContext",
        "title": "Add to Context",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.askAboutSelection",
        "title": "Add Selection to Chat",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.askAboutFile",
        "title": "Explain Current File",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.addTerminalOutput",
        "title": "Add Terminal Selection to Context",
        "category": "PerplexiCode"
      },
      {
        "command": "perplexicodeKilo.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "PerplexiCode",
        "icon": "$(sparkle)"
      },
      {
        "command": "perplexicodeKilo.importLegacyAccounts",
        "title": "Import Accounts from PerplexiCode 1.x",
        "category": "PerplexiCode"
      }
    ],
    "keybindings": [
      {
        "command": "perplexicodeKilo.askAboutSelection",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "perplexicodeKilo.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus"
      },
      {
        "command": "perplexicodeKilo.newTask",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "perplexicodeKilo.openChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "perplexicodeKilo.cycleMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "focusedView == perplexicodeKilo.chatView || activeWebviewPanelId == perplexicodeKilo.tab"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "perplexicodeKilo.newTask",
          "when": "view == perplexicodeKilo.chatView",
          "group": "navigation@1"
        },
        {
          "command": "perplexicodeKilo.history",
          "when": "view == perplexicodeKilo.chatView",
          "group": "navigation@2"
        },
        {
          "command": "perplexicodeKilo.settings",
          "when": "view == perplexicodeKilo.chatView",
          "group": "navigation@3"
        },
        {
          "command": "perplexicodeKilo.openInTab",
          "when": "view == perplexicodeKilo.chatView",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "submenu": "perplexicodeKilo.editorMenu",
          "group": "1_perplexicode@1"
        }
      ],
      "perplexicodeKilo.editorMenu": [
        {
          "command": "perplexicodeKilo.addToContext",
          "group": "1@1"
        },
        {
          "command": "perplexicodeKilo.explainCode",
          "when": "editorHasSelection",
          "group": "1@2"
        },
        {
          "command": "perplexicodeKilo.fixCode",
          "group": "1@3"
        },
        {
          "command": "perplexicodeKilo.improveCode",
          "when": "editorHasSelection",
          "group": "1@4"
        },
        {
          "command": "perplexicodeKilo.askAboutFile",
          "group": "2@1"
        }
      ],
      "terminal/context": [
        {
          "command": "perplexicodeKilo.addTerminalOutput",
          "group": "perplexicode@1"
        }
      ],
      "scm/title": [
        {
          "command": "perplexicodeKilo.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "perplexicodeKilo.addTerminalOutput",
          "when": "terminalFocus"
        }
      ]
    },
    "configuration": {
      "title": "PerplexiCode Kilo",
      "properties": {
        "perplexicodeKilo.defaultModel": {
          "type": "string",
          "default": "turbo",
          "enum": [
            "turbo",
            "gpt6_1_sol",
            "gpt6_astra",
            "gemini4argon",
            "gemini38flash",
            "claude55sonnet",
            "claude55opus",
            "claudefable51",
            "kimik3thinking",
            "glm_5_3_thinking",
            "grok47",
            "nv_nemotron_3_5_super",
            "experimental"
          ],
          "enumDescriptions": [
            "Best (Perplexity auto)",
            "GPT-6.1 Sol",
            "GPT-6 Astra (Max)",
            "Gemini 4 Argon (Max)",
            "Gemini 3.8 Flash",
            "Claude Sonnet 5.5",
            "Claude Opus 5.5 (Max)",
            "Claude Fable 5.1 (Max)",
            "Kimi K3",
            "GLM 5.3",
            "Grok 4.7",
            "Nemotron 3.5 Super VL",
            "Sonar"
          ],
          "markdownDescription": "Model used for new sessions. Any model from the in-chat picker (including the 77 under **More models**) can be chosen there."
        },
        "perplexicodeKilo.subscriptionPlan": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "pro",
            "max"
          ],
          "enumDescriptions": [
            "Detect from the account",
            "Treat accounts as Perplexity Pro",
            "Treat accounts as Perplexity Max (unlocks Max-only models in the picker)"
          ],
          "description": "Override the detected subscription plan when Perplexity does not report it correctly."
        },
        "perplexicodeKilo.agent.autoApprove.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for auto-approval."
        },
        "perplexicodeKilo.agent.autoApprove.read": {
          "type": "boolean",
          "default": true,
          "description": "Auto-approve reading files and listing/searching inside the workspace."
        },
        "perplexicodeKilo.agent.autoApprove.readOutsideWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve reads outside the workspace."
        },
        "perplexicodeKilo.agent.autoApprove.write": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve creating and editing files."
        },
        "perplexicodeKilo.agent.autoApprove.execute": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve terminal commands that match perplexicodeKilo.agent.allowedCommands."
        },
        "perplexicodeKilo.agent.autoApprove.modeSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Auto-approve mode switches requested by the agent."
        },
        "perplexicodeKilo.agent.autoApprove.subtasks": {
          "type": "boolean",
          "default": true,
          "description": "Auto-approve subtasks created by the Orchestrator."
        },
        "perplexicodeKilo.agent.autoApprove.todo": {
          "type": "boolean",
          "default": true,
          "description": "Auto-approve todo list updates."
        },
        "perplexicodeKilo.agent.autoApprove.retry": {
          "type": "boolean",
          "default": true,
          "description": "Automatically retry failed Perplexity requests."
        },
        "perplexicodeKilo.agent.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "npm test",
            "npm run",
            "git status",
            "git diff",
            "git log",
            "ls",
            "cat",
            "pwd"
          ],
          "description": "Command prefixes that can run without approval when command auto-approval is enabled. Use * to allow everything."
        },
        "perplexicodeKilo.agent.deniedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rm -rf",
            "sudo",
            "git push --force"
          ],
          "description": "Command prefixes that always require approval."
        },
        "perplexicodeKilo.agent.maxRequestsPerTask": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "description": "Ask before continuing after this many consecutive requests."
        },
        "perplexicodeKilo.agent.maxReadFileLines": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "description": "Maximum lines returned by one read_file call."
        },
        "perplexicodeKilo.agent.commandTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "Terminal command timeout (0 = no timeout)."
        },
        "perplexicodeKilo.agent.terminalOutputLineLimit": {
          "type": "number",
          "default": 300,
          "minimum": 20,
          "description": "Maximum terminal output lines sent to the model."
        },
        "perplexicodeKilo.agent.webSearch": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Mode decides (Ask/Architect search the web)",
            "Always search the web",
            "Never search the web"
          ],
          "description": "Whether Perplexity may search the web for agent requests."
        },
        "perplexicodeKilo.agent.contextStrategy": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "full",
            "thread"
          ],
          "enumDescriptions": [
            "Continue the Perplexity thread when possible, resend full context on failure",
            "Always send the full task context",
            "Prefer Perplexity thread follow-ups"
          ],
          "description": "How the conversation is sent to Perplexity."
        },
        "perplexicodeKilo.agent.maxPromptChars": {
          "type": "number",
          "default": 60000,
          "minimum": 8000,
          "description": "Upper bound for the prompt size; older turns are condensed beyond it."
        },
        "perplexicodeKilo.agent.language": {
          "type": "string",
          "default": "auto",
          "description": "Language the agent replies in (auto = language of your latest message), for example \"ru\" or \"en\"."
        },
        "perplexicodeKilo.agent.customInstructions": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "Custom instructions added to every mode (like Kilo Code custom instructions). Workspace rules from .kilocode/rules, .roo/rules, .clinerules, AGENTS.md are also loaded."
        },
        "perplexicodeKilo.agent.modeInstructions": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Per-mode custom instructions, keyed by mode slug (code, architect, ask, debug, orchestrator, review)."
        },
        "perplexicodeKilo.agent.diffEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Let the agent use apply_diff (SEARCH/REPLACE) edits instead of rewriting whole files."
        },
        "perplexicodeKilo.agent.includeFileListOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Include the workspace file list in the first request of a task."
        },
        "perplexicodeKilo.agent.revealEditedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Open files in the editor after the agent edits them."
        },
        "perplexicodeKilo.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/.next/**"
          ],
          "description": "Glob patterns for files to exclude from context"
        }
      }
    },
    "submenus": [
      {
        "id": "perplexicodeKilo.editorMenu",
        "label": "PerplexiCode"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --out perplexicode-kilo.vsix",
    "lint": "tsc --noEmit && tsc -p webview-ui/tsconfig.json",
    "test": "node ./test/run-tests.mjs",
    "test:webview": "node ./test/webview-render.mjs",
    "vscode:prepublish": "node scripts/build-bridge.mjs && node esbuild.js",
    "build:bridge": "node scripts/build-bridge.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "puppeteer-core": "^24.39.0",
    "sql.js": "^1.14.1"
  },
  "license": "MIT"
}
