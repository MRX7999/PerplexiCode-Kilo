# Optional MCP credentials. Leave unused variables empty.
# PerplexiCode does NOT load .env files automatically.
# Export only the variables needed by your CLI session, or use native IDE
# password prompts for catalog entries and keep tokens in VS Code SecretStorage.
# Never pass token values as CLI arguments or commit a populated .env file.

# General catalog: use minimally scoped tokens.
GITHUB_PERSONAL_ACCESS_TOKEN=
CONTEXT7_API_KEY=
# Notion MCP token, not an integration token; workspace owner, Business/Enterprise.
NOTION_MCP_TOKEN=
LINEAR_API_KEY=
SENTRY_AUTH_TOKEN=

# Optional manual security integrations. These are setup guides, not auto-installs.
SEMGREP_APP_TOKEN=
SHODAN_API_KEY=
ZAP_SECURITY_KEY=
# Absolute path to the protected VTAI token file, never the token itself.
VTAI_TOKEN_FILE=
