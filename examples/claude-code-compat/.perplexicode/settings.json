{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Edit(package.json)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Read(./secrets/**)",
      "Edit(./.github/workflows/**)"
    ],
    "protectSecrets": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.perplexicode/hooks/guard.sh", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "npx --no-install prettier --write \"$(jq -r '.tool_input.file_path')\" >/dev/null 2>&1 || true" }]
      }
    ]
  },
  "verify": {
    "command": "npm test",
    "maxAttempts": 2,
    "timeoutSec": 600
  },
  "readBatchSize": 5
}
